# ── Environment variables ──────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to Git.

# QuickNode (or another provider) Sepolia RPC endpoint
# Get one free at https://www.quicknode.com or use the public fallback below
QUICKNODE_SEPOLIA_URL=https://rpc.sepolia.org

# The private key of your burner deployer wallet (with 0x prefix)
# Fund it with Sepolia ETH from: https://sepoliafaucet.com or https://faucet.quicknode.com/ethereum/sepolia
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# (Optional) Etherscan API key for contract source verification
# Get one free at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=
